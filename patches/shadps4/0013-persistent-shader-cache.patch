+/// Directory mode: the blob goes to a temporary file that is then renamed over the old one, so a
+/// process killed while writing leaves at most a stray *.tmp (removed at the next Open), never a
+/// truncated blob under the real name.
+bool WriteFileAtomic(const std::filesystem::path& path, std::span<const u8> blob) {
+    // One temporary name per process: two processes sharing a generation (A/B builds of one
+    // translator) never write the same temporary file.
+#ifdef _WIN32
+    static const u64 pid = static_cast<u64>(_getpid());
+#else
+    static const u64 pid = static_cast<u64>(getpid());
+#endif
+    auto tmp = path;
+    tmp += fmt::format(".tmp{}", pid);
+    {
+        using namespace Common::FS;
+        const IOFile file{tmp, FileAccessMode::Create};
+        if (!file.IsOpen() || file.WriteSpan(blob) != blob.size() || !file.Flush()) {
+            return false;
+        }
+    }
+    std::error_code ec;
+    std::filesystem::rename(tmp, path, ec);
+    if (ec) {
+        std::filesystem::remove(tmp, ec);
+        return false;
+    }
+    return true;
+}
