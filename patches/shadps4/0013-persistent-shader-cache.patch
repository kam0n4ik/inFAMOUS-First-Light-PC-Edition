+void PipelineCache::CreateDriverCache() {
+    std::vector<u8> data;
+    auto& db = Storage::DataBase::Instance();
+    if (db.IsOpened() && db.ReadFile(DriverCacheFile, data)) {
+        // vulkan.bin: our header, then the driver's own data, which starts with
+        // VkPipelineCacheHeaderVersionOne. Both must name this device and driver.
+        DriverCacheHeader header{};
+        VkPipelineCacheHeaderVersionOne vk_header{};
+        const auto uuid = instance.GetPipelineCacheUUID();
+        bool valid = data.size() >= sizeof(header) + sizeof(vk_header);
+        if (valid) {
+            std::memcpy(&header, data.data(), sizeof(header));
+            std::memcpy(&vk_header, data.data() + sizeof(header), sizeof(vk_header));
+            valid = header.vendor_id == instance.GetVendorID() &&
+                    header.device_id == instance.GetDeviceID() &&
+                    header.driver_version == instance.GetDriverVersion() &&
+                    std::memcmp(header.uuid.data(), uuid.data(), VK_UUID_SIZE) == 0 &&
+                    vk_header.headerVersion == VK_PIPELINE_CACHE_HEADER_VERSION_ONE &&
+                    vk_header.vendorID == instance.GetVendorID() &&
+                    vk_header.deviceID == instance.GetDeviceID() &&
+                    std::memcmp(vk_header.pipelineCacheUUID, uuid.data(), VK_UUID_SIZE) == 0;
+        }
+        if (valid) {
+            const auto initial = std::span<const u8>{data}.subspan(sizeof(header));
+            auto [result, cache] = instance.GetDevice().createPipelineCacheUnique({
+                .initialDataSize = initial.size(),
+                .pInitialData = initial.data(),
+            });
+            if (result == vk::Result::eSuccess) {
+                pipeline_cache = std::move(cache);
+                Bump(stats.driver_cache_bytes, initial.size());
+                LOG_INFO(Render, "Driver pipeline cache: {:.1f} MiB loaded",
+                         initial.size() / 1048576.0);
+            } else {
+                LOG_WARNING(Render,
+                            "Driver pipeline cache rejected by the driver ({}), started empty",
+                            vk::to_string(result));
+            }
+        } else {
+            LOG_WARNING(Render, "Driver pipeline cache of another device or driver, started empty");
+        }
+    }
+    if (!pipeline_cache) {
+        auto [cache_result, cache] = instance.GetDevice().createPipelineCacheUnique({});
+        ASSERT_MSG(cache_result == vk::Result::eSuccess, "Failed to create pipeline cache: {}",
+                   vk::to_string(cache_result));
+        pipeline_cache = std::move(cache);
+    }
+    if (db.IsOpened()) {
+        db.SetDriverCacheWriter([this] {
+            SaveDriverCache();
+            LogStats("at exit");
+        });
+    }
+}
+
+void PipelineCache::SaveDriverCache() const {
+    if (stats.driver_cache_bytes.load() != 0 && stats.graphics.load() == 0 && stats.compute.load() == 0) {
+        return; // loaded at start and nothing new created since: the file on disk is current
+    }
+    const auto device = instance.GetDevice();
+    auto [result, data] = device.getPipelineCacheData(*pipeline_cache);
+    if (result != vk::Result::eSuccess || data.empty()) {
+        LOG_WARNING(Render, "Driver pipeline cache: no data ({})", vk::to_string(result));
+        return;
+    }
+    DriverCacheHeader header{
+        .vendor_id = instance.GetVendorID(),
+        .device_id = instance.GetDeviceID(),
+        .driver_version = instance.GetDriverVersion(),
+    };
+    const auto uuid = instance.GetPipelineCacheUUID();
+    std::memcpy(header.uuid.data(), uuid.data(), VK_UUID_SIZE);
+    std::vector<u8> file(sizeof(header) + data.size());
+    std::memcpy(file.data(), &header, sizeof(header));
+    std::memcpy(file.data() + sizeof(header), data.data(), data.size());
+    if (Storage::DataBase::Instance().WriteFile(DriverCacheFile, file)) {
+        LOG_INFO(Render, "Driver pipeline cache: {:.1f} MiB saved", data.size() / 1048576.0);
+    }
+}
+
+void PipelineCache::EndCompileStall() {
+    const u64 us = call_compile_us;
+    call_compile_us = 0;
+    Bump(stats.stalls);
+    Bump(stats.stall_us, us);
+    if (us >= 5'000) {
+        Bump(stats.stalls_5ms);
+    }
+    if (us >= 20'000) {
+        Bump(stats.stalls_20ms);
+    }
+    if (us >= 100'000) {
+        Bump(stats.stalls_100ms);
+    }
+    if (us > stats.stall_max_us.load(std::memory_order_relaxed)) {
+        stats.stall_max_us.store(us, std::memory_order_relaxed);
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_stats_log >= std::chrono::seconds{10}) {
+        last_stats_log = now;
+        LogStats("while compiling");
+    }
+}
+
+void PipelineCache::LogStats(std::string_view when) const {
+    const auto& s = stats;
+    const auto ms = [](const std::atomic<u64>& us) { return us.load() / 1000.0; };
+    LOG_INFO(Render,
+             "Shader cache stats ({}): compiled modules {} + permutations {}, graphics {}, compute "
+             "{}; preloaded modules {}, graphics {}, compute {}, stale {}, used {}; ms translate "
+             "{:.1f} spirv {:.1f} module {:.1f} graphics {:.1f} compute {:.1f}; stalls {} "
+             "({:.1f} ms, >5ms {}, >20ms {}, >100ms {}, max {:.1f} ms); warm-up {:.1f} ms; driver "
+             "cache {} bytes; persistent cache {}",
+             when, s.modules.load(), s.permutations.load(), s.graphics.load(), s.compute.load(),
+             s.preloaded_modules.load(), s.preloaded_graphics.load(), s.preloaded_compute.load(),
+             s.stale.load(), s.preloaded_used.load(), ms(s.translate_us), ms(s.emit_us),
+             ms(s.module_us), ms(s.graphics_us), ms(s.compute_us), s.stalls.load(),
+             ms(s.stall_us), s.stalls_5ms.load(), s.stalls_20ms.load(), s.stalls_100ms.load(),
+             ms(s.stall_max_us), ms(s.warmup_us), s.driver_cache_bytes.load(),
+             // The directory stays known after Close (the last summary is written while closing).
+             Storage::DataBase::Instance().Path().empty() ? "off" : "on");
+}
