+++ b/src/core/tls.cpp
@@ -44,6 +44,17 @@ u32 GetTcbKey() {
     return slot;
 }
 
+// SecondSonPC P3.3 (patch 0021): the TCB slot is SecondSonPC's; the bridge's threads and patcher use it
+// instead of allocating one. Only before the bridge has taken a slot of its own.
+bool UseTcbKey(u32 key) {
+    bool taken = false;
+    std::call_once(slot_alloc_flag, [&] {
+        slot = key;
+        taken = true;
+    });
+    return taken || slot == key;
+}
+
 void SetTcbBase(void* image_address) {
     const BOOL result = TlsSetValue(GetTcbKey(), image_address);
     ASSERT(result != 0);
