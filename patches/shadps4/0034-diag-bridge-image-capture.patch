+void Rasterizer::SspcDiagCapture(u64 flip) {
+    struct Want {
+        VAddr addr;
+        u64 flip;
+    };
+    static const std::vector<Want> wants = [] {
+        std::vector<Want> v;
+        const char* s = std::getenv("SSPC_DIAG_BRIDGE_CAPTURE");
+        if (s == nullptr) {
+            return v;
+        }
+        std::string str(s);
+        char* p = str.data();
+        while (*p != 0) {
+            Want w{std::strtoull(p, &p, 16), 0};
+            if (*p == ':') {
+                w.flip = std::strtoull(p + 1, &p, 10);
+            }
+            v.push_back(w);
+            while (*p == ',' || *p == ' ') {
+                ++p;
+            }
+        }
+        LOG_WARNING(Render_Vulkan, "SecondSonPC diagnostics: SSPC_DIAG_BRIDGE_CAPTURE - {} image captures", v.size());
+        std::filesystem::create_directories("logs/p45");
+        std::ofstream("logs/p45/bridge_capture_status.txt", std::ios::app)
+            << fmt::format("SSPC_DIAG_BRIDGE_CAPTURE: {} captures", v.size()) << '\n';
+        return v;
+    }();
+    for (const Want& w : wants) {
+        if (w.flip != flip) {
+            continue;
+        }
+        const VideoCore::ImageId id = texture_cache.SspcGpuModifiedAt(w.addr);
+        {
+            std::filesystem::create_directories("logs/p45");
+            std::ofstream status("logs/p45/bridge_capture_status.txt", std::ios::app);
+            status << fmt::format("flip {} address {:#x}: {}", flip, w.addr, id ? "found" : "no GPU-modified image") << '\n';
+        }
+        if (!id) {
+            LOG_WARNING(Render_Vulkan, "SecondSonPC diagnostics: no GPU-modified image at {:#x} at flip {}", w.addr,
+                        flip);
+            continue;
+        }
+        VideoCore::Image& image = texture_cache.GetImage(id);
+        const bool depth = image.info.props.is_depth;
+        const u32 texel = depth ? (image.info.num_bits == 16 ? 2u : 4u) : std::max(image.info.num_bits / 8, 1u);
+        const u32 w_px = image.info.size.width, h_px = image.info.size.height;
+        const u32 layers = std::min<u32>(image.info.resources.layers, 8);
+        const u64 layer_bytes = u64{w_px} * h_px * texel;
+        const auto staging =
+            runtime.GetStagingPool().Request(layer_bytes * layers, VideoCore::MemoryType::HostCached, 16, true);
+        std::vector<vk::BufferImageCopy> copies;
+        for (u32 l = 0; l < layers; ++l) {
+            copies.push_back(vk::BufferImageCopy{
+                .bufferOffset = staging.offset + l * layer_bytes,
+                .bufferRowLength = w_px,
+                .bufferImageHeight = h_px,
+                .imageSubresource = {.aspectMask = depth ? vk::ImageAspectFlagBits::eDepth
+                                                         : vk::ImageAspectFlagBits::eColor,
+                                     .mipLevel = 0,
+                                     .baseArrayLayer = l,
+                                     .layerCount = 1},
+                .imageOffset = {0, 0, 0},
+                .imageExtent = {w_px, h_px, 1},
+            });
+        }
+        runtime.DownloadImage(&image, staging.buffer, copies);
+        scheduler.Finish();
+        staging.Invalidate();
+        const int format = depth ? (texel == 2 ? 124 : 126) : static_cast<int>(image.info.pixel_format);
+        std::filesystem::create_directories("logs/p45");
+        for (u32 l = 0; l < layers; ++l) {
+            const std::string base = fmt::format("logs/p45/bridge_image_{:x}_{}_l{}", w.addr, flip, l);
+            std::ofstream raw(base + ".raw", std::ios::binary | std::ios::trunc);
+            raw.write(reinterpret_cast<const char*>(staging.mapped + l * layer_bytes),
+                      static_cast<std::streamsize>(layer_bytes));
+            std::ofstream meta(base + ".txt", std::ios::trunc);
+            meta << fmt::format("format={} width={} height={} row_bytes={} texel_bytes={}\n", format, w_px, h_px,
+                                u64{w_px} * texel, texel);
+        }
+        runtime.GetStagingPool().FreeDeferred(staging);
+        LOG_WARNING(Render_Vulkan, "SecondSonPC diagnostics: captured {:#x} ({}x{} format {} layers {}) at flip {}",
+                    w.addr, w_px, h_px, format, layers, flip);
+    }
+}
+
 void Rasterizer::Finish() {
     scheduler.Finish();
 }
