+    /// SecondSonPC P4.5 diagnostics (SSPC_DIAG_BRIDGE_CAPTURE): the GPU-modified image starting at `address` that was
+    /// used last; {} when none.
+    ImageId SspcGpuModifiedAt(VAddr address) {
+        ImageId best{};
+        u64 tick = 0;
+        ForEachImageWithAddress(address, [&](ImageId id, Image& img) {
+            if (True(img.flags & ImageFlagBits::GpuModified) && img.info.guest_address == address &&
+                (!best || img.tick_accessed_last >= tick)) {
+                best = id;
+                tick = img.tick_accessed_last;
+            }
+        });
+        return best;
+    }
+
