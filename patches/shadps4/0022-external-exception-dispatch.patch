+// SecondSonPC (P3.4, patch 0022): SecondSonPC's exception dispatcher in place of this handler.
+static bool g_external_dispatch = false;
+static void (*g_external_on_remove)() = nullptr;
+
+void UseExternalExceptionDispatch(void (*on_remove)()) {
+    g_external_dispatch = true;
+    g_external_on_remove = on_remove;
+}
+
+bool ExternalExceptionDispatch() {
+    return g_external_dispatch;
+}
+
 SignalDispatch::SignalDispatch() {
 #if defined(_WIN32)
+    if (g_external_dispatch) {
+        return; // the handlers below are called by SecondSonPC's dispatcher
+    }
     ASSERT_MSG(handle = AddVectoredExceptionHandler(0, SignalHandler),
                "Failed to register exception handler.");
 #else
@@ -373,6 +389,12 @@ void SignalDispatch::RemoveHandlers() {
     // asserting here would get into an infinite loop until too
     // many nested exceptions makes the OS kill the process
 #if defined(_WIN32)
+    if (g_external_dispatch) {
+        if (g_external_on_remove != nullptr) {
+            g_external_on_remove();
+        }
+        return;
+    }
     if (!(RemoveVectoredExceptionHandler(handle))) {
         LOG_CRITICAL(Core, "Failed to remove exception handler.");
         std::quick_exit(1);
