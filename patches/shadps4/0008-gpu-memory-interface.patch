@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SecondSonPC patch 0008 (P2.3.2, docs/PHASE2_P232_GPU_MEMORY.md): the guest memory as the GPU
+// bridge uses it. video_core and GnmDriver reach the memory manager only through GpuMemory, and
+// the memory manager reaches the GPU only through GpuMemoryListener. The implementation is the
+// bridge's MemoryManager (memory.cpp); another memory manager has to keep the same contract.
+
+#pragma once
+
+#include "common/types.h"
+#include "core/address_space.h"
+
+namespace Core {
+
+/// The memory manager's notifications, in this order for one map/unmap/release: OnGpuUnmap
+/// (before the address space changes, writer lock not held) -> OnGpuRegister (host pages mapped
+/// or unmapped, writer lock held) -> OnGpuMap (writer lock not held). The operation's unmap lock
+/// is held throughout: a listener must not map or unmap guest memory.
+class GpuMemoryListener {
+public:
+    virtual ~GpuMemoryListener() = default;
+    /// [addr, addr + size) is about to be unmapped or replaced: write back and drop GPU caches.
+    virtual void OnGpuUnmap(VAddr addr, u64 size) = 0;
+    /// The host pages of [addr, addr + size) were mapped or unmapped (page tracking tables).
+    virtual void OnGpuRegister(VAddr addr, u64 size) = 0;
+    /// [addr, addr + size) is mapped and visible to the GPU.
+    virtual void OnGpuMap(VAddr addr, u64 size) = 0;
+    /// Host code writes [addr, addr + size) past the page tracking (file reads, mprotect).
+    virtual void OnGuestWrite(VAddr addr, u64 size) = 0;
+};
+
+class GpuMemory {
+public:
+    /// Smaller ranges are not clamped and cost no lookup (every buffer bind asks).
+    static constexpr u64 MinSizeToClamp = 1_GB;
+
+    virtual ~GpuMemory() = default;
+
+    /// The PS4's GPU can only handle 40 bit addresses. addr + size is not checked for overflow.
+    static constexpr bool IsValidGpuMapping(VAddr addr, u64 size) {
+        constexpr VAddr max_gpu_address{0x10000000000};
+        return addr + size < max_gpu_address;
+    }
+
+    /// Who gets the notifications (the rasterizer, once, before the guest runs); returns the
+    /// previous listener. Not synchronized with memory operations.
+    virtual GpuMemoryListener* SetListener(GpuMemoryListener* listener) = 0;
+
+    /// size, or less: the rest of addr's area plus the mapped areas that follow it. A snapshot,
+    /// stale after the next map or unmap. addr must be inside the guest address space.
+    u64 ClampRangeSize(VAddr addr, u64 size) {
+        return size < MinSizeToClamp ? size : ClampLargeRange(addr, size);
+    }
+
+    /// Reads guest memory through the physical backing; pages without one read as zeros. No lock,
+    /// never faults: a range unmapped meanwhile reads stale data. addr + size <= 2^40.
+    virtual void CopySparseMemory(VAddr addr, u8* dest, u64 size) = 0;
+
+    /// Writes guest memory through the physical backing, past any page protection. false when
+    /// the area at address has no physical backing. Runs in the access violation handler too.
+    virtual bool TryWriteBacking(void* address, const void* data, u64 size) = 0;
+
+    /// Host protection of the mapped pages in the range for GPU access tracking (None, Read or
+    /// ReadWrite); the guest's protection stays. Runs in the access violation handler: no
+    /// allocation, no logging, only the address space's own lock.
+    virtual void ProtectTracking(VAddr addr, u64 size, MemoryPermission perms) = 0;
+
+    /// End of the system reserved part of the guest address space (constant).
+    virtual VAddr SystemReservedEnd() = 0;
+
+protected:
+    virtual u64 ClampLargeRange(VAddr addr, u64 size) = 0;
+};
+
+/// The GPU bridge's guest memory: the bridge's MemoryManager. Valid for the process lifetime.
+GpuMemory& GetGpuMemory();
+
+} // namespace Core
