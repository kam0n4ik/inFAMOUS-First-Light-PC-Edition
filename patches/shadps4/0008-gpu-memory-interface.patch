+namespace {
+
+// SecondSonPC patch 0008: the GPU bridge's view of this memory manager. No state of its own.
+class BridgeGpuMemory final : public GpuMemory {
+public:
+    GpuMemoryListener* SetListener(GpuMemoryListener* listener) override {
+        return Memory::Instance()->SetGpuListener(listener);
+    }
+
+    void CopySparseMemory(VAddr addr, u8* dest, u64 size) override {
+        Memory::Instance()->CopySparseMemory(addr, dest, size);
+    }
+
+    bool TryWriteBacking(void* address, const void* data, u64 size) override {
+        return Memory::Instance()->TryWriteBacking(address, data, size);
+    }
+
+    void ProtectTracking(VAddr addr, u64 size, MemoryPermission perms) override {
+        Memory::Instance()->GetAddressSpace().Protect(addr, size, perms);
+    }
+
+    VAddr SystemReservedEnd() override {
+        auto& address_space = Memory::Instance()->GetAddressSpace();
+        return address_space.SystemReservedVirtualBase() + address_space.SystemReservedVirtualSize();
+    }
+
+protected:
+    u64 ClampLargeRange(VAddr addr, u64 size) override {
+        return Memory::Instance()->ClampRangeSize(addr, size);
+    }
+};
+
+BridgeGpuMemory bridge_gpu_memory;
+
+} // Anonymous namespace
+
+GpuMemory& GetGpuMemory() {
+    return bridge_gpu_memory;
+}
+
 } // namespace Core
