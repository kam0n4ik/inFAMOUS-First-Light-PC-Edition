+std::vector<GuestArea> MemoryManager::GetAreas() {
+    std::shared_lock lk{mutex};
+    std::vector<GuestArea> areas;
+    for (const auto& [base, vma] : vma_map) {
+        if (vma.type == VMAType::Free) {
+            continue;
+        }
+        const PAddr phys = vma.phys_areas.empty() ? -1 : vma.phys_areas.begin()->second.base;
+        areas.push_back(GuestArea{base, vma.size, vma.type, vma.prot, phys,
+                                  static_cast<u32>(vma.phys_areas.size()), vma.name});
+    }
+    return areas;
+}
+
 VAddr MemoryManager::SearchFree(VAddr virtual_addr, u64 size, u32 alignment) {
     // Calculate the minimum and maximum addresses present in our address space.
     auto min_search_address = impl.SystemManagedVirtualBase();
@@ -1806,10 +1820,85 @@ protected:
 
 BridgeGpuMemory bridge_gpu_memory;
 
+// SecondSonPC patch 0009: everyone else's view of this memory manager. No state of its own: each
+// call is the manager call its users made before the interface, with the same arguments.
+class BridgeGuestMemory final : public GuestVirtualMemory,
+                                public GuestPhysicalMemory,
+                                public GuestWriteNotifier {
+public:
+    void Reserve() override {
+        (void)Memory::Instance();
+    }
+
+    s32 Map(void** out_addr, const GuestMapping& m) override {
+        return Memory::Instance()->MapMemory(out_addr, m.addr, m.size, m.prot, m.flags, m.type,
+                                             m.name, m.exclusive, m.phys, m.alignment);
+    }
+
+    s32 Unmap(VAddr addr, u64 size) override {
+        return Memory::Instance()->UnmapMemory(addr, size);
+    }
+
+    s32 Protect(VAddr addr, u64 size, MemoryProt prot) override {
+        return Memory::Instance()->Protect(addr, size, prot);
+    }
+
+    void NameRange(VAddr addr, u64 size, std::string_view name) override {
+        Memory::Instance()->NameVirtualRange(addr, size, name);
+    }
+
+    bool IsValid(VAddr addr, u64 size) override {
+        return Memory::Instance()->IsValidMapping(addr, size);
+    }
+
+    VAddr SystemReservedBase() override {
+        return Memory::Instance()->GetAddressSpace().SystemReservedVirtualBase();
+    }
+
+    std::vector<GuestArea> Areas() override {
+        return Memory::Instance()->GetAreas();
+    }
+
+    void SetupRegions(u64 flexible_size, bool use_extended_mem1, bool use_extended_mem2) override {
+        Memory::Instance()->SetupMemoryRegions(flexible_size, use_extended_mem1, use_extended_mem2);
+    }
+
+    u64 DirectSize() override {
+        return Memory::Instance()->GetTotalDirectSize();
+    }
+
+    PAddr AllocateDirect(PAddr search_start, PAddr search_end, u64 size, u64 alignment,
+                         s32 memory_type) override {
+        return Memory::Instance()->Allocate(search_start, search_end, size, alignment, memory_type);
+    }
+
+    s32 ReleaseDirect(PAddr start, u64 size, bool checked) override {
+        return Memory::Instance()->Free(start, size, checked);
+    }
+
+    void NotifyHostWrite(VAddr addr, u64 size) override {
+        Memory::Instance()->InvalidateMemory(addr, size);
+    }
+};
+
+BridgeGuestMemory bridge_guest_memory;
+
 } // Anonymous namespace
 
 GpuMemory& GetGpuMemory() {
     return bridge_gpu_memory;
 }
 
+GuestVirtualMemory& GetGuestVirtualMemory() {
+    return bridge_guest_memory;
+}
+
+GuestPhysicalMemory& GetGuestPhysicalMemory() {
+    return bridge_guest_memory;
+}
+
+GuestWriteNotifier& GetGuestWriteNotifier() {
+    return bridge_guest_memory;
+}
+
 } // namespace Core
