diff --git a/src/core/guest_memory.h b/src/core/guest_memory.h
new file mode 100644
index 00000000..47909c10
--- /dev/null
+++ b/src/core/guest_memory.h
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SecondSonPC patch 0009 (P2.3.3a, docs/PHASE2_P233_MEMORY_DEPENDENCIES.md): the guest memory as
+// everything but the GPU bridge (core/gpu_memory.h) and libkernel's memory functions uses it: the
+// loader, the threads' stacks and heap, file reads into guest buffers. Calls are at the memory
+// manager's level (libkernel's argument checks are the caller's). The implementation is the
+// bridge's MemoryManager (memory.cpp); another memory manager has to keep the same contract.
+
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+#include "common/enum.h"
+#include "common/types.h"
+
+namespace Core {
+
+enum class MemoryProt : u32 {
+    NoAccess = 0,
+    CpuRead = 1,
+    CpuWrite = 2,
+    CpuReadWrite = 3,
+    CpuExec = 4,
+    GpuRead = 16,
+    GpuWrite = 32,
+    GpuReadWrite = 48,
+};
+DECLARE_ENUM_FLAG_OPERATORS(MemoryProt)
+
+enum class MemoryMapFlags : u32 {
+    NoFlags = 0,
+    Shared = 1,
+    Private = 2,
+    Fixed = 0x10,
+    NoOverwrite = 0x80,
+    Void = 0x100,
+    Stack = 0x400,
+    NoSync = 0x800,
+    Anon = 0x1000,
+    System = 0x2000,
+    NoCore = 0x20000,
+    NoCoalesce = 0x400000,
+};
+DECLARE_ENUM_FLAG_OPERATORS(MemoryMapFlags)
+
+enum class VMAType : u32 {
+    Free = 0,
+    Reserved = 1,
+    Direct = 2,
+    Flexible = 3,
+    Pooled = 4,
+    PoolReserved = 5,
+    Stack = 6,
+    Code = 7,
+    File = 8,
+    System = 9,
+};
+
+/// One mapping as the memory manager takes it.
+struct GuestMapping {
+    /// With MemoryMapFlags::Fixed the address itself, else where the search for a free range
+    /// starts (0: the manager's default base).
+    VAddr addr = 0;
+    u64 size = 0;
+    MemoryProt prot = MemoryProt::NoAccess;
+    MemoryMapFlags flags = MemoryMapFlags::NoFlags;
+    VMAType type = VMAType::Reserved;
+    std::string_view name = "anon";
+    PAddr phys = -1;        ///< Direct: the physical address
+    bool exclusive = false; ///< Direct: EBUSY when a page of it is already mapped
+    u64 alignment = 0;      ///< 0: one page
+};
+
+/// A virtual memory area in use (diagnostics).
+struct GuestArea {
+    VAddr base = 0;
+    u64 size = 0;
+    VMAType type = VMAType::Free;
+    MemoryProt prot = MemoryProt::NoAccess;
+    PAddr phys = -1;     ///< the first physical address, -1 without a physical backing
+    u32 phys_slices = 0; ///< physical areas behind it
+    std::string name;
+};
+
+/// The guest's virtual address space: ranges, mappings, protection, names.
+class GuestVirtualMemory {
+public:
+    virtual ~GuestVirtualMemory() = default;
+
+    /// Takes the guest address space now, before the host allocates much (start-up); later calls
+    /// do nothing.
+    virtual void Reserve() = 0;
+
+    /// 0 or a libkernel error code; *out_addr is where the range was mapped. Notifies the GPU.
+    virtual s32 Map(void** out_addr, const GuestMapping& mapping) = 0;
+
+    virtual s32 Unmap(VAddr addr, u64 size) = 0;
+
+    /// The guest's protection of [addr, addr + size), applied to the host pages.
+    virtual s32 Protect(VAddr addr, u64 size, MemoryProt prot) = 0;
+
+    virtual void NameRange(VAddr addr, u64 size, std::string_view name) = 0;
+
+    /// addr, and with a size all of [addr, addr + size), inside the managed address space (free
+    /// areas count, gaps between the host's regions do not).
+    virtual bool IsValid(VAddr addr, u64 size = 0) = 0;
+
+    /// Start of the system reserved part of the guest address space (constant).
+    virtual VAddr SystemReservedBase() = 0;
+
+    /// The areas in use (free ones left out), in address order: a snapshot.
+    virtual std::vector<GuestArea> Areas() = 0;
+};
+
+/// The guest's physical memory: budgets and direct memory.
+class GuestPhysicalMemory {
+public:
+    virtual ~GuestPhysicalMemory() = default;
+
+    /// The direct and flexible memory budgets from the executable's SceKernelMemParam (start-up,
+    /// before the guest runs).
+    virtual void SetupRegions(u64 flexible_size, bool use_extended_mem1,
+                              bool use_extended_mem2) = 0;
+
+    virtual u64 DirectSize() = 0;
+
+    /// First fit in [search_start, search_end); -1 when nothing fits.
+    virtual PAddr AllocateDirect(PAddr search_start, PAddr search_end, u64 size, u64 alignment,
+                                 s32 memory_type) = 0;
+
+    /// Unmaps the views of [start, start + size) (the GPU first) and frees it. `checked`: ENOENT
+    /// when a page is not allocated.
+    virtual s32 ReleaseDirect(PAddr start, u64 size, bool checked) = 0;
+};
+
+/// Who must hear of host writes into guest memory (the GPU's page tracking).
+class GuestWriteNotifier {
+public:
+    virtual ~GuestWriteNotifier() = default;
+
+    /// The host writes [addr, addr + size) of guest memory past the GPU's page tracking (file
+    /// reads into guest buffers): called before the write.
+    virtual void NotifyHostWrite(VAddr addr, u64 size) = 0;
+};
+
+/// The guest memory: the bridge's MemoryManager. Valid for the process lifetime.
+GuestVirtualMemory& GetGuestVirtualMemory();
+GuestPhysicalMemory& GetGuestPhysicalMemory();
+GuestWriteNotifier& GetGuestWriteNotifier();
+
+} // namespace Core
