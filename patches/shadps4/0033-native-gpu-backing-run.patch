+// SecondSonPC P4.4: the backing's view of the run of guest memory around addr (see GpuMemory::BackingRun).
+bool MemoryManager::BackingRun(VAddr addr, u8** host, VAddr* run_begin, u64* run_size) {
+    std::shared_lock lk{mutex};
+    if (vma_map.empty() || !IsValidMapping(addr)) {
+        return false;
+    }
+    const auto& vma = FindVMA(addr)->second;
+    const bool backed = vma.type == VMAType::Direct || vma.type == VMAType::Flexible ||
+                        vma.type == VMAType::Pooled;
+    if (!backed || !vma.Contains(addr, 1) || vma.phys_areas.empty()) {
+        return false;
+    }
+    const u64 in_vma = addr - vma.base;
+    auto phys = vma.phys_areas.upper_bound(in_vma);
+    if (phys == vma.phys_areas.begin()) {
+        return false;
+    }
+    --phys;
+    if (in_vma >= phys->first + phys->second.size) {
+        return false;
+    }
+    *host = impl.BackingBase() + phys->second.base;
+    *run_begin = vma.base + phys->first;
+    *run_size = std::min<u64>(phys->second.size, vma.size - phys->first);
+    return true;
+}
