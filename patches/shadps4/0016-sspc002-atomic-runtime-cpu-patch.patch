+bool HandlePatchBreakpoint(void* context, void* exception_address, bool misreported) {
+    // SecondSonPC SSPC-002: the int3 of a patch WriteLiveCode is writing (or has just written). The
+    // exception address is the int3; one byte later is accepted too, whichever the system reports.
+    // Reported as a privileged instruction (misreported) only at the instruction itself.
+    auto* const address = static_cast<u8*>(exception_address);
+    if (misreported) {
+        auto* module = GetContainingModule(address);
+        if (module == nullptr) {
+            return false;
+        }
+        std::unique_lock lock{module->mutex};
+        if (!module->patched.contains(address)) {
+            return false;
+        }
+#if defined(_WIN32)
+        static_cast<CONTEXT*>(context)->Rip = reinterpret_cast<DWORD64>(address);
+#else
+        (void)context;
+#endif
+        patch_breakpoints.fetch_add(1, std::memory_order_relaxed);
+        patch_breakpoints_misreported.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+    for (u8* site : {address, address - 1}) {
+        auto* module = GetContainingModule(site);
+        if (module == nullptr) {
+            continue;
+        }
+        std::unique_lock lock{module->mutex}; // the patch being written holds it until it is complete
+        if (!module->patched.contains(site)) {
+            continue;
+        }
+#if defined(_WIN32)
+        static_cast<CONTEXT*>(context)->Rip = reinterpret_cast<DWORD64>(site);
+#else
+        (void)context; // only Windows writes patches with an int3 first
+#endif
+        patch_breakpoints.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+    return false;
+}
+
+u64 PatchBreakpointsHandled() {
+    return patch_breakpoints.load(std::memory_order_relaxed);
+}
+
+u64 PatchBreakpointsMisreported() {
+    return patch_breakpoints_misreported.load(std::memory_order_relaxed);
+}
