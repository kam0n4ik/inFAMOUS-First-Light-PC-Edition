+/// SecondSonPC SSPC-002: number of guest threads that reached a patch while it was being written
+/// (HandlePatchBreakpoint) - diagnostics for --patch-race-test and the log.
+static std::atomic<u64> patch_breakpoints{0};
+static std::atomic<u64> patch_breakpoints_misreported{0};
+
+/// SecondSonPC SSPC-002: replaces `size` bytes of an instruction other threads may be executing so
+/// that none of them can ever decode a mix of old and new bytes (as Linux's text_poke_bp): an int3
+/// goes into the first byte, then the rest of the new bytes behind it, then the new first byte;
+/// FlushProcessWriteBuffers between the steps serializes every processor running this process. A
+/// thread that reaches the int3 meanwhile traps and HandlePatchBreakpoint sends it back to the
+/// instruction once the patch is complete (the caller holds the module's mutex until then).
+static void WriteLiveCode(u8* code, const u8* bytes, size_t size) {
+#if defined(_WIN32)
+    std::atomic_ref<u8>(code[0]).store(0xCC, std::memory_order_seq_cst);
+    FlushProcessWriteBuffers();
+    std::memcpy(code + 1, bytes + 1, size - 1);
+    FlushProcessWriteBuffers();
+    std::atomic_ref<u8>(code[0]).store(bytes[0], std::memory_order_seq_cst);
+    FlushProcessWriteBuffers();
+    FlushInstructionCache(GetCurrentProcess(), code, size);
+#else
+    std::memcpy(code, bytes, size);
+#endif
+}
