@@ -862,7 +887,24 @@ static std::pair<bool, u64> TryPatch(u8* code, PatchModule* module, bool allow_t
                     }
 
                     // Replace instruction with near jump to the trampoline.
-                    patch_gen.jmp(trampoline_ptr, Xbyak::CodeGenerator::LabelType::T_NEAR);
+                    // SecondSonPC SSPC-002: other guest threads may be running this very instruction.
+                    // Written byte by byte (Xbyak) one of them could fetch a torn jump - the new
+                    // opcode with old displacement bytes, a jump to module + 0x25xxxxxx - so the
+                    // whole jump (nops after it) goes in with WriteLiveCode.
+                    const s64 displacement = trampoline_ptr - (code + NearJumpSize);
+                    ASSERT_MSG(displacement == static_cast<s32>(displacement),
+                               "Trampoline {} is out of reach of {}", fmt::ptr(trampoline_ptr),
+                               fmt::ptr(code));
+                    std::array<u8, 16> jump;
+                    jump.fill(0x90); // nop: never executed, the jump comes first
+                    jump[0] = 0xE9;
+                    const s32 rel32 = static_cast<s32>(displacement);
+                    std::memcpy(&jump[1], &rel32, sizeof(rel32));
+                    WriteLiveCode(code, jump.data(), instruction.length);
+                    module->patched.insert(code);
+                    LOG_DEBUG(Core, "Patched instruction '{}' at: {}",
+                              ZydisMnemonicGetString(instruction.mnemonic), fmt::ptr(code));
+                    return std::make_pair(true, instruction.length);
                 } else {
                     patch_info.generator(code, instruction, operands, patch_gen);
                 }
