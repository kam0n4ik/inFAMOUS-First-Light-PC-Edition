+#include <atomic>
 #include <thread>
 #include <boost/asio/io_context.hpp>
 
@@ -84,13 +85,24 @@ static PS4_SYSV_ABI void stack_chk_fail() {
 }
 
 static thread_local s32 g_posix_errno = 0;
+// SecondSonPC P3.5.1 (patch 0023): when set, the guest errno is SecondSonPC's cell (UseExternalErrno). Set once
+// before any guest thread runs; every access below goes through __Error(), so there is one owner either way.
+static std::atomic<s32* (*)()> g_external_errno{nullptr};
 
 s32* PS4_SYSV_ABI __Error() {
+    if (const auto location = g_external_errno.load(std::memory_order_relaxed)) {
+        return location();
+    }
     return &g_posix_errno;
 }
 
+bool UseExternalErrno(s32* (*location)()) {
+    s32* (*expected)() = nullptr;
+    return location != nullptr && g_external_errno.compare_exchange_strong(expected, location);
+}
+
 void ErrSceToPosix(s32 error) {
-    g_posix_errno = error - ORBIS_KERNEL_ERROR_UNKNOWN;
+    *__Error() = error - ORBIS_KERNEL_ERROR_UNKNOWN;
 }
 
