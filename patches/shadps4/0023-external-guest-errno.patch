-        g_posix_errno = POSIX_EBADF;
+        *__Error() = POSIX_EBADF;
         return -1;
     }
     if (file->type != Core::FileSys::FileType::Device) {
         LOG_WARNING(Lib_Kernel, "ioctl: fd = {:X} cmd = {:X} file->type != Device", fd, cmd);
-        g_posix_errno = ENOTTY;
+        *__Error() = ENOTTY;
         return -1;
     }
     VA_CTX(ctx);
