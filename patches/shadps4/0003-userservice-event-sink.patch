index d7924797..73608698 100644
--- a/src/core/libraries/system/userservice.cpp
+++ b/src/core/libraries/system/userservice.cpp
@@ -117,8 +117,17 @@ int PS4_SYSV_ABI sceUserServiceGetDiscPlayerFlag() {
 }
 
 std::queue<OrbisUserServiceEvent> user_service_event_queue = {};
+static UserServiceEventSink g_event_sink = nullptr; // SecondSonPC patch 0003
+
+void SetUserServiceEventSink(UserServiceEventSink sink) {
+    g_event_sink = sink;
+}
 
 void AddUserServiceEvent(const OrbisUserServiceEvent e) {
+    if (g_event_sink != nullptr) {
+        g_event_sink(e);
+        return;
+    }
     LOG_DEBUG(Lib_UserService, "Event added to queue: {} {}", (u8)e.event, e.userId);
     user_service_event_queue.push(e);
 }
