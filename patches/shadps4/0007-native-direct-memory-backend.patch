+bool MemoryManager::SetDirectMemoryBackend(DirectMemoryBackend* backend) {
+    std::scoped_lock lk{unmap_mutex, mutex};
+    const bool untouched = dmem_map.size() == 1 &&
+                           dmem_map.begin()->second.dma_type == PhysicalMemoryType::Free;
+    const bool direct_mapped = std::ranges::any_of(
+        vma_map, [](const auto& vma) { return vma.second.type == VMAType::Direct; });
+    if (!untouched || direct_mapped) {
+        return false;
+    }
+    dmem_backend = backend;
+    return true;
+}
+
+s32 MemoryManager::UnmapDirectPhysical(std::span<const std::pair<PAddr, u64>> ranges) {
+    std::scoped_lock lk{unmap_mutex};
+    // Exactly the overlap of every direct view with the ranges.
+    std::vector<std::pair<VAddr, u64>> remove_list;
+    for (const auto& [addr, vma] : vma_map) {
+        if (vma.type != VMAType::Direct) {
+            continue;
+        }
+        for (const auto& [offset_in_vma, phys] : vma.phys_areas) {
+            for (const auto& [base, size] : ranges) {
+                const PAddr lo = std::max<PAddr>(base, phys.base);
+                const PAddr hi = std::min<PAddr>(base + size, phys.base + phys.size);
+                if (lo < hi) {
+                    remove_list.emplace_back(vma.base + offset_in_vma + (lo - phys.base), hi - lo);
+                }
+            }
+        }
+    }
+
+    // GPU first, as in Free.
+    for (const auto& [addr, size] : remove_list) {
+        if (IsValidGpuMapping(addr, size)) {
+            rasterizer->UnmapMemory(addr, size);
+        }
+    }
+
+    std::scoped_lock lk2{mutex};
+    for (const auto& [addr, size] : remove_list) {
+        LOG_INFO(Kernel_Vmm, "Unmapping direct mapping {:#x} with size {:#x}", addr, size);
+        UnmapMemoryImpl(addr, size);
+    }
+    return ORBIS_OK;
+}
