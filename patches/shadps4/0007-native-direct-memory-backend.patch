+// SecondSonPC patch 0007 (P2.3.1, docs/PHASE2_P23_MEMORY.md): when a backend is set, the physical
+// direct memory is accounted by SecondSonPC instead of dmem_map (allocation, release, which pages are
+// mapped by how many views); the virtual side stays here. Set before any direct memory is allocated.
+class DirectMemoryBackend {
+public:
+    struct Slice {
+        PAddr base;
+        u64 size;
+        s32 memory_type;
+    };
+    virtual ~DirectMemoryBackend() = default;
+    virtual u64 TotalSize() = 0;
+    virtual s32 Allocate(PAddr search_start, PAddr search_end, u64 size, u64 alignment,
+                         s32 memory_type, PAddr* out) = 0;
+    virtual s32 Release(PAddr start, u64 size, bool checked) = 0;
+    /// A view of [phys, phys+size) is being mapped: all or nothing; `out` = its physical slices.
+    virtual s32 BeginMap(PAddr phys, u64 size, bool exclusive, std::vector<Slice>& out) = 0;
+    /// A view of [phys, phys+size) is gone (or BeginMap is rolled back).
+    virtual void EndMap(PAddr phys, u64 size) = 0;
+};
