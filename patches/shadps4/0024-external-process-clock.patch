@@ -491,6 +512,14 @@ Common::NativeClock* GetClock() {
     return clock.get();
 }
 
+void AdvanceProcessEpoch(u64 ticks) {
+    if (const auto* external = g_external_clock.load(std::memory_order_relaxed)) {
+        external->advance_epoch(ticks);
+        return;
+    }
+    initial_ptc += ticks;
+}
