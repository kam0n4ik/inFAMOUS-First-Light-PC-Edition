diff --git a/src/core/libraries/kernel/time.h b/src/core/libraries/kernel/time.h
index d876fe7b..502027d5 100644
--- a/src/core/libraries/kernel/time.h
+++ b/src/core/libraries/kernel/time.h
@@ -68,8 +68,23 @@ namespace Dev {
 u64& GetInitialPtc();
 
 Common::NativeClock* GetClock();
+/// The debugger's pause: the paused TSC ticks do not count in the process time (the process clock's owner's epoch).
+void AdvanceProcessEpoch(u64 ticks);
 } // namespace Dev
 
+/// SecondSonPC P3.5.3 (patch 0024): the process clock's owner — its TSC frequency, process time and process time
+/// counter replace the bridge's NativeClock (VideoOut's flip/vblank stamps, AudioOut's pacing, the GPU's timestamp
+/// scale, input timestamps). The TSC itself (sceKernelReadTsc) is the same counter either way.
+struct ExternalClock {
+    u64 (*tsc_frequency)();           ///< TSC ticks per second
+    u64 (*process_time_us)();         ///< microseconds since the process epoch
+    u64 (*process_time_counter)();    ///< TSC ticks since the process epoch
+    void (*advance_epoch)(u64 ticks); ///< the debugger's pause
+};
+/// Once, before RegisterTime (libkernel's RegisterLib); `clock` lives until the process ends. false for nullptr, a
+/// second call, or after RegisterTime (the bridge's own clock is then in use).
+bool UseExternalClock(const ExternalClock* clock);
+
 u64 PS4_SYSV_ABI sceKernelGetTscFrequency();
 u64 PS4_SYSV_ABI sceKernelGetProcessTime();
 u64 PS4_SYSV_ABI sceKernelGetProcessTimeCounter();
