#version 450
// SecondSonPC P4.6: the write-back of a GPU-written range - only the words the GPU changed since the range's last sync
// with the host (`shadow` holds that state) are written to the host's memory (and to the shadow).
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Cache { uint cache_words[]; };
layout(std430, set = 0, binding = 1) buffer Shadow { uint shadow_words[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Host { uint host_words[]; };
layout(push_constant) uniform Params {
    uint count;
    uint cache_first;
    uint shadow_first;
    uint host_first;
} p;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) {
        return;
    }
    const uint v = cache_words[p.cache_first + i];
    if (v != shadow_words[p.shadow_first + i]) {
        shadow_words[p.shadow_first + i] = v;
        host_words[p.host_first + i] = v;
    }
}
