// SecondSonPC - robust contrast-adaptive sharpening after the upscaler (DLSS has no sharpening of its own; FSR's is
// its built-in RCAS). The filter of AMD FidelityFX RCAS (FSR 1, MIT): a cross of 5 texels, a negative lobe limited so
// the result never leaves the neighbourhood's range (no ringing, no halo), scaled by the sharpness.
// Regenerate: E:\VulkanSDK\Bin\glslangValidator.exe -V --target-env vulkan1.3 -x -o rcas_spv.inc rcas.comp
#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform texture2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform Push {
    float sharpness; // 0..1: the lobe's weight (1: RCAS at 0 stops)
} pc;

vec3 Fetch(ivec2 p, ivec2 size) {
    return texelFetch(src, clamp(p, ivec2(0), size - 1), 0).rgb;
}

void main() {
    const ivec2 size = imageSize(dst);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    const vec3 b = Fetch(p + ivec2(0, -1), size);
    const vec3 d = Fetch(p + ivec2(-1, 0), size);
    const vec4 ec = texelFetch(src, p, 0);
    const vec3 e = ec.rgb;
    const vec3 f = Fetch(p + ivec2(1, 0), size);
    const vec3 h = Fetch(p + ivec2(0, 1), size);
    const vec3 mn4 = min(min(b, d), min(f, h));
    const vec3 mx4 = max(max(b, d), max(f, h));
    // the lobe that keeps the result inside [min, max] of the cross
    const vec3 hit_min = min(mn4, e) / max(4.0 * mx4, vec3(1e-5));
    const vec3 hit_max = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1e-5));
    const vec3 lobe3 = max(-hit_min, hit_max);
    const float lobe = max(-0.1875, min(max(lobe3.r, max(lobe3.g, lobe3.b)), 0.0)) * pc.sharpness;
    const vec3 result = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
    imageStore(dst, p, vec4(clamp(result, 0.0, 1.0), ec.a));
}
