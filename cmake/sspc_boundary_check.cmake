# SecondSonPC <-> bridge boundary check (Phase 3, P3.6.6; docs/PHASE3_P36_BRIDGE_ISOLATION.md §2). Script mode:
#   cmake -DSSPC_SRC=<src> -DSSPC_SHAD=<third_party/shadPS4/src> -DSSPC_PATCHES=<patches/shadps4>
#         -DSSPC_ALLOWLIST=<cmake/sspc_boundary_allowlist.txt> -DSSPC_REPORT=<file> [-DSSPC_STAMP=<file>]
#         -P cmake/sspc_boundary_check.cmake
# Fails (FATAL_ERROR) when
#   1. a file of SecondSonPC's own runtime (src/ except src/bridge and src/app/main.cpp) includes a header that is
#      not SecondSonPC's (it resolves only in the bridge) or one of the adapter layer (bridge/...);
#   2. such a file names a namespace of the bridge outside comments and strings (`Libraries::Kernel::foo`, a
#      `namespace Core {` block): a declaration of a bridge symbol compiles and links without its header;
#   3. an adapter-layer file (src/bridge/** except generated/, src/app/main.cpp) includes a shadPS4 header that its
#      line of the allowlist does not list (or the file has no line);
#   4. a patch of the bridge adds an include of a SecondSonPC header not listed as "bridge -> ..." in the allowlist.
# It writes a report: the counts, every adapter file's shadPS4 headers, allowlisted headers no longer included
# (stale entries), what the patches include and the contract points they add.
# Limits: quoted includes only (angle-bracket ones are system and third-party libraries); comments are stripped
# line by line (`//`, single-line `/* */`, lines of a `/* ... */` block that start with `*`); a namespace used
# through a macro or `using namespace` of a bridge namespace alias is not seen; the patched shadPS4 tree is checked
# through its patches (only they can add a dependency on SecondSonPC).
cmake_minimum_required(VERSION 3.24)

foreach(_v SSPC_SRC SSPC_SHAD SSPC_PATCHES SSPC_ALLOWLIST SSPC_REPORT)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "sspc_boundary_check: -D${_v}=... is required")
    endif()
endforeach()

set(_bridge_ns "Libraries|Core|Common|VideoCore|Vulkan|AmdGpu|Shader|Frontend|Platform|Dev|ImGui|Storage|Emulator")
set(_errors "")
set(_report "")

function(_key out path)
    string(MAKE_C_IDENTIFIER "${path}" _k)
    set(${out} "${_k}" PARENT_SCOPE)
endfunction()

# --- the allowlist
file(STRINGS "${SSPC_ALLOWLIST}" _allow_lines ENCODING UTF-8)
set(_allow_files "")
set(_bridge_allowed "")
foreach(_line IN LISTS _allow_lines)
    string(STRIP "${_line}" _line)
    if(_line STREQUAL "" OR _line MATCHES "^#")
        continue()
    endif()
    if(_line MATCHES "^bridge -> ([^ |]+)")
        list(APPEND _bridge_allowed "${CMAKE_MATCH_1}")
        continue()
    endif()
    string(REPLACE "|" ";" _parts "${_line}")
    list(LENGTH _parts _n)
    if(_n LESS 4)
        list(APPEND _errors "allowlist: malformed line (want <file> | <owner> | <reason> | <headers>): ${_line}")
        continue()
    endif()
    list(GET _parts 0 _file)
    list(GET _parts 1 _owner)
    list(GET _parts 2 _reason)
    list(GET _parts 3 _headers)
    string(STRIP "${_file}" _file)
    string(STRIP "${_owner}" _owner)
    string(STRIP "${_reason}" _reason)
    string(STRIP "${_headers}" _headers)
    if(_owner STREQUAL "" OR _reason STREQUAL "")
        list(APPEND _errors "allowlist: ${_file} has no owner or no reason")
    endif()
    separate_arguments(_headers UNIX_COMMAND "${_headers}")
    _key(_k "${_file}")
    set(_allow_${_k} "${_headers}")
    set(_allow_seen_${_k} TRUE)
    list(APPEND _allow_files "${_file}")
endforeach()

# Strips string literals and comments from one line (a piece of one: file(STRINGS) splits at ';').
function(_clean out line)
    string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" line "${line}")
    string(REGEX REPLACE "/\\*.*\\*/" "" line "${line}")
    string(REGEX REPLACE "//.*$" "" line "${line}")
    string(REGEX REPLACE "/\\*.*$" "" line "${line}")
    if(line MATCHES "^[ \t]*\\*")
        set(line "")
    endif()
    set(${out} "${line}" PARENT_SCOPE)
endfunction()

# --- the files
file(GLOB_RECURSE _all RELATIVE "${SSPC_SRC}" "${SSPC_SRC}/*.cpp" "${SSPC_SRC}/*.h" "${SSPC_SRC}/*.inc")
list(SORT _all)
set(_own_files 0)
set(_own_includes 0)
set(_adapter_files 0)
set(_adapter_bridge_includes 0)
set(_bridge_headers "")
set(_adapter_lines "")
foreach(_rel IN LISTS _all)
    set(_path "src/${_rel}")
    set(_adapter FALSE)
    if(_rel MATCHES "^bridge/" OR _rel STREQUAL "app/main.cpp")
        set(_adapter TRUE)
    endif()
    if(_rel MATCHES "^bridge/shadps4/generated/")
        continue() # generated from the import table: every BRIDGE export's declaration
    endif()
    file(STRINGS "${SSPC_SRC}/${_rel}" _incs REGEX "^[ \t]*#[ \t]*include[ \t]+\"" ENCODING UTF-8)
    set(_file_bridge "")
    foreach(_inc IN LISTS _incs)
        if(NOT _inc MATCHES "#[ \t]*include[ \t]+\"([^\"]+)\"")
            continue()
        endif()
        set(_h "${CMAKE_MATCH_1}")
        if(EXISTS "${SSPC_SRC}/${_h}")
            if(NOT _adapter AND _h MATCHES "^bridge/")
                list(APPEND _errors "${_path}: SecondSonPC's runtime includes the adapter layer's ${_h}")
            endif()
            if(NOT _adapter)
                math(EXPR _own_includes "${_own_includes} + 1")
            endif()
            continue()
        endif()
        # Not SecondSonPC's: a header of the bridge (or a typo).
        if(NOT _adapter)
            list(APPEND _errors "${_path}: SecondSonPC's runtime includes ${_h}, which is not a SecondSonPC header")
            continue()
        endif()
        list(APPEND _file_bridge "${_h}")
    endforeach()
    if(_adapter)
        math(EXPR _adapter_files "${_adapter_files} + 1")
        _key(_k "${_path}")
        list(LENGTH _file_bridge _nb)
        math(EXPR _adapter_bridge_includes "${_adapter_bridge_includes} + ${_nb}")
        list(APPEND _bridge_headers ${_file_bridge})
        if(_nb GREATER 0 AND NOT DEFINED _allow_seen_${_k})
            list(APPEND _errors "${_path}: includes shadPS4 headers (${_file_bridge}) but has no line in the allowlist")
        endif()
        foreach(_h IN LISTS _file_bridge)
            if(DEFINED _allow_seen_${_k} AND NOT _h IN_LIST _allow_${_k})
                list(APPEND _errors "${_path}: new direct dependency on the bridge's ${_h} (not in its allowlist line)")
            endif()
        endforeach()
        set(_stale "")
        if(DEFINED _allow_seen_${_k})
            foreach(_h IN LISTS _allow_${_k})
                if(NOT _h IN_LIST _file_bridge)
                    list(APPEND _stale "${_h}")
                endif()
            endforeach()
        endif()
        string(REPLACE ";" " " _fb "${_file_bridge}")
        string(APPEND _adapter_lines "  ${_path}: ${_nb} shadPS4 headers ${_fb}\n")
        if(_stale)
            string(REPLACE ";" " " _st "${_stale}")
            string(APPEND _adapter_lines "    stale allowlist entries (no longer included): ${_st}\n")
        endif()
        continue()
    endif()
    math(EXPR _own_files "${_own_files} + 1")
    # Rule 2: no namespace of the bridge in SecondSonPC's own code.
    file(STRINGS "${SSPC_SRC}/${_rel}" _uses REGEX "(${_bridge_ns})::|namespace[ \t]+(${_bridge_ns})" ENCODING UTF-8)
    foreach(_piece IN LISTS _uses)
        _clean(_c "${_piece}")
        if(_c MATCHES "(^|[^A-Za-z0-9_:])(${_bridge_ns})::" OR _c MATCHES "^[ \t]*namespace[ \t]+(${_bridge_ns})([ \t{:]|$)")
            string(STRIP "${_c}" _c)
            list(APPEND _errors "${_path}: names the bridge's namespace: ${_c}")
        endif()
    endforeach()
endforeach()
foreach(_file IN LISTS _allow_files)
    if(NOT EXISTS "${SSPC_SRC}/../${_file}")
        list(APPEND _errors "allowlist: ${_file} does not exist")
    endif()
endforeach()

# --- the patches: bridge -> SecondSonPC
file(GLOB _patches "${SSPC_PATCHES}/*.patch")
list(SORT _patches)
set(_patch_lines "")
set(_contract_lines "")
foreach(_patch IN LISTS _patches)
    get_filename_component(_pname "${_patch}" NAME)
    file(STRINGS "${_patch}" _added REGEX "^\\+" ENCODING UTF-8)
    set(_sspc_refs 0)
    foreach(_piece IN LISTS _added)
        if(_piece MATCHES "^\\+[ \t]*#[ \t]*include[ \t]+\"([^\"]+)\"")
            set(_h "${CMAKE_MATCH_1}")
            if(EXISTS "${SSPC_SRC}/${_h}" AND NOT EXISTS "${SSPC_SHAD}/${_h}")
                if(NOT _h IN_LIST _bridge_allowed)
                    list(APPEND _errors "${_pname}: the bridge includes SecondSonPC's ${_h} (not a \"bridge ->\" entry)")
                endif()
                string(APPEND _patch_lines "  ${_pname}: includes ${_h}\n")
            endif()
        endif()
        if(_piece MATCHES "SecondSon::")
            math(EXPR _sspc_refs "${_sspc_refs} + 1")
        endif()
        if(_piece MATCHES "^\\+[^/]*[ *&]((Use|Select)[A-Z][A-Za-z]+|Set[A-Za-z]*(Sink|Interceptor|Listener|Backend|Memory))\\(")
            string(APPEND _contract_lines "  ${_pname}: ${CMAKE_MATCH_1}\n")
        endif()
    endforeach()
    if(_sspc_refs GREATER 0)
        string(APPEND _patch_lines "  ${_pname}: ${_sspc_refs} added lines name SecondSon::\n")
    endif()
endforeach()

list(REMOVE_DUPLICATES _bridge_headers)
list(LENGTH _bridge_headers _distinct)
list(LENGTH _errors _nerr)
list(LENGTH _patches _npatches)
string(APPEND _report "SecondSonPC <-> bridge boundary (cmake/sspc_boundary_check.cmake)\n")
string(APPEND _report "own runtime: ${_own_files} files, ${_own_includes} quoted includes, all SecondSonPC's; no bridge namespace\n")
string(APPEND _report "adapter layer: ${_adapter_files} files, ${_adapter_bridge_includes} direct includes of ${_distinct} distinct shadPS4 headers (all allowlisted); generated/ exempt\n")
string(APPEND _report "bridge -> SecondSonPC: ${_npatches} patches\n${_patch_lines}")
string(APPEND _report "contract points added by the patches:\n${_contract_lines}")
string(APPEND _report "adapter files:\n${_adapter_lines}")
string(APPEND _report "violations: ${_nerr}\n")
foreach(_e IN LISTS _errors)
    string(APPEND _report "  ${_e}\n")
endforeach()
file(WRITE "${SSPC_REPORT}" "${_report}")

if(_nerr GREATER 0)
    string(REPLACE ";" "\n  " _list "${_errors}")
    message(FATAL_ERROR "SecondSonPC boundary: ${_nerr} violation(s) (report ${SSPC_REPORT}):\n  ${_list}")
endif()
message(STATUS "SecondSonPC boundary: own runtime ${_own_files} files clean; adapter layer ${_adapter_files} files, "
               "${_adapter_bridge_includes} allowlisted shadPS4 includes (${_distinct} headers); report ${SSPC_REPORT}")
if(DEFINED SSPC_STAMP)
    file(TOUCH "${SSPC_STAMP}")
endif()
